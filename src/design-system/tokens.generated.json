  "motion": {
    "base": {
      "duration": 500,
      "easing": {
        "type": "bezier",
        "points": [
          0.32,
          0.72,
          0,
          1
        ]
      }
    },
    "micro": {
      "duration": 200,
      "easing": {
        "type": "bezier",
        "points": [
          0.32,
          0.72,
          0,
          1
        ]
      }
    },
    "exit": {
      "duration": 300,
      "easing": {
        "type": "bezier",
        "points": [
          0.55,
          0,
          0.85,
          0.2
        ]
      }
    },
    "sheet": {
      "duration": 500,
      "easing": {
        "type": "spring",
        "response": 0.35,
        "dampingRatio": 0.86
      }
    },
    "celebration": {
      "duration": 700,
      "easing": {
        "type": "bezier",
        "points": [
          0.34,
          1.56,
          0.64,
          1
        ]
      }
    },
    "timer": {
      "duration": 10000,
      "easing": {
        "type": "linear"
      }
    }
  },
