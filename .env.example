# Modèle de configuration locale : copier vers `.env.local` pour la stack locale (jamais versionné).
# Sans fichier, l'app cible la production. Tout ce qui est préfixé `EXPO_PUBLIC_` est embarqué dans l'app,
# donc public : aucun secret ici. Après tout changement, relancer `npx expo start -c`.

# BFF (joutio-bff)
EXPO_PUBLIC_API_URL=https://api.joutio.com

# Identity (joutio-identity) : base OIDC et endpoints natifs
EXPO_PUBLIC_OIDC_AUTHORITY=https://identity.joutio.com
EXPO_PUBLIC_OIDC_CLIENT_ID=mobile

# Site public (conditions, confidentialité)
EXPO_PUBLIC_SITE_URL=https://joutio.com

# Connexions sociales : masquées tant que leur configuration native n'est pas reprise de joutio-mobile.
EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false
EXPO_PUBLIC_FACEBOOK_SIGN_IN_ENABLED=false

# Catalogue des composants en première page (phase de construction). false pour la production.
EXPO_PUBLIC_CATALOG=true
