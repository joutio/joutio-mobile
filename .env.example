# Modèle de configuration locale — copier vers `.env` (jamais versionné).
# `.env` cible la production par défaut ; pour la stack locale, surcharger dans `.env.local`.
#
# Aucune valeur secrète ici : tout ce qui est préfixé `EXPO_PUBLIC_` est embarqué dans
# l'application et donc public. Les secrets serveur (App Secret Facebook, client secrets OIDC,
# keystore Android) ne doivent JAMAIS être ajoutés dans ce fichier.

# BFF (joutio-bff)
EXPO_PUBLIC_API_URL=https://api.joutio.com

# Identity (joutio-identity) — base OIDC et endpoints natifs
EXPO_PUBLIC_OIDC_AUTHORITY=https://identity.joutio.com
EXPO_PUBLIC_OIDC_CLIENT_ID=mobile

# Google (client OAuth2 Web public, audience des ID tokens).
# Vide ⇒ bouton Google masqué. Aucun secret ici.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# Google iOS (client OAuth iOS public + URL scheme inversé).
# Les deux sont requis ensemble : le plugin natif iOS n'est ajouté que si
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME est défini.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Facebook (App ID public + Client Token public du SDK).
# Vide ⇒ bouton Facebook masqué et plugin natif non ajouté. Aucun App Secret ici.
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
EXPO_PUBLIC_FACEBOOK_SIGN_IN_ENABLED=false
